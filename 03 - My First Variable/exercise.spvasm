     OpCapability Shader
     OpMemoryModel Logical GLSL450
     OpEntryPoint Vertex %3 "main"

%float = OpTypeFloat 32
%floatptr = OpTypePointer Private %float
%init = OpConstant %float 3.14
%myvar = OpVariable %floatptr Private %init

%1 = OpTypeVoid
%2 = OpTypeFunction %1
%3 = OpFunction %1 None %2
%4 = OpLabel
     OpReturn
     OpFunctionEnd
